# Dalal Server Environment Configuration

# HTTP Port
PORT=8000

# Providers in order of preference (first working provider wins)
# Options: nse, yahoo
MARKET_PROVIDER=nse,yahoo

# Refresh interval (seconds) during active trading hours (09:15-15:30 IST)
MARKET_REFRESH_INTERVAL=60

# Refresh interval (seconds) outside trading hours
MARKET_CLOSED_REFRESH_INTERVAL=1800

# IST time for the post-closing snapshot sync
DAILY_MARKET_SYNC=15:45

# Timezone for market calendar
TIMEZONE=Asia/Kolkata

# Minimum gap in seconds between external provider requests (rate limiter)
MARKET_MIN_GAP=1.2

# Cooldown duration in seconds when encountering HTTP 429 rate limit
MARKET_COOLDOWN=300

# Offline mode (1 = skip external network requests, use cache/snapshot)
MARKET_OFFLINE=0

# Database cache path
MARKET_DB=dalal.db
